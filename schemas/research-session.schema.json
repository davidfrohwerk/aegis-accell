{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-accell.dev/schemas/research-session.schema.json",
  "title": "ResearchSession",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityBase"
    },
    {
      "type": "object",
      "required": ["title", "researchQuestion", "status"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "researchQuestion": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "paused", "completed", "archived"]
        },
        "claimIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "assumptionIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "uncertaintyMarkerIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "provenanceItemIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "contradictionIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "failureMarkerIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "fatigueIndicatorIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "redTeamCheckpointIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "unlearningPromptIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "salvageWorkflowNoteIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
