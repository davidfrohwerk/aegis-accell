{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-accell.dev/schemas/failure-marker.schema.json",
  "title": "FailureMarker",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityBase"
    },
    {
      "type": "object",
      "required": ["researchSessionId", "text", "status", "severity", "confidence"],
      "properties": {
        "researchSessionId": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityId"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["potential", "triggered", "mitigated", "accepted"]
        },
        "severity": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/severity"
        },
        "confidence": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/confidence"
        },
        "mitigationText": {
          "type": "string"
        },
        "claimIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "contradictionIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        },
        "fatigueIndicatorIds": {
          "$ref": "https://aegis-accell.dev/schemas/common.schema.json#/$defs/entityIdList"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
